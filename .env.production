# ============================================
# AI Drama Video - 生产环境变量 (Ubuntu)
# ============================================
# 复制此文件为 .env 并修改所有密码和密钥:
#   cp .env.production .env
# ============================================

# ---------- 对外端口 ----------
APP_PORT=3000

# ---------- PostgreSQL ----------
PG_USERNAME=postgres
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_DATABASE=aidrama

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- NextAuth 密钥 ----------
# 生成: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET

# ---------- AI 服务 ----------
AI_DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ---------- 前端公开变量 ----------
# 如使用反向代理，设为代理地址（如 https://your-domain.com）
NEXT_PUBLIC_API_BASE_URL=
